{
  "name": "digital-asset-packager",
  "version": "1.0.0",
  "description": "A micro-SaaS for packaging Markdown content into branded PDF and EPUB downloads.",
  "main": "src/server.js",
  "scripts": {
    "prestart": "npm run build:css",
    "start": "node src/server.js",
    "dev": "npm run build:css && node --watch src/server.js",
    "build:css": "tailwindcss -i ./public/styles.css -o ./public/dist.css --minify"
  },
  "keywords": [
    "ebook",
    "pdf",
    "epub",
    "markdown",
    "packager",
    "saas"
  ],
  "author": "Nikhilr23",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "epub-gen": "^0.1.0",
    "express": "^4.19.2",
    "marked": "^13.0.0",
    "pg": "^8.12.0",
    "puppeteer": "^23.1.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.13"
  }
}
